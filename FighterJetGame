def find(a,char):
    for ind in range(len(a)):
        if char == a[ind]:
            return ind
def validate(s):
    e = ["EXIT","TERMINATE","QUIT"]
    print("to exit press".title())
    print("+______________________________+")
    [print("\t",x.capitalize()) for x in e]
    print("valid spaceships include".title())
    print("+______________________________+")
    [print("\t",x.capitalize()) for x in a]
    _s = input(s)

    if _s.upper() in e:
        quit()
    elif _s.lower() in a:
        return _s.lower()
    else:
        validate()

def generate():
    return random.choice(a)

def compare(player,cpu):
    global a;
    winningconditions = [[0,1],[1,2],[2,0]]
    losingconditions = [x[::-1] for x in winningconditions]
    if player == cpu:
        return "tie"
    elif [find(a,player),find(a,cpu)] in winningconditions:
        return "win"
    elif [find(a,player),find(a,cpu)] in winningconditions:
        return "lose"
    else:
        return "something went wrong"
